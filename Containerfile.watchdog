FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/python-312-minimal@sha256:d0ac54e77cd0be473b22fb274493526027f2746ec503b4a97ca08257813f0d4b

USER 0

RUN groupadd --gid 10001 watch-auth \
    && useradd --uid 10001 --gid watch-auth \
        --home-dir /home/watch-auth --create-home --shell /sbin/nologin watch-auth

WORKDIR /opt/watch-auth

COPY requirements-watchdog-build.lock requirements-watchdog.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-watchdog-build.lock \
    && python -m pip install --no-cache-dir --no-build-isolation --require-hashes -r requirements-watchdog.lock \
    && python -m pip uninstall -y setuptools wheel

COPY --chown=10001:10001 infra infra

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/watch-auth

USER 10001:10001

CMD ["python", "-m", "infra.ibm_watchdog"]
