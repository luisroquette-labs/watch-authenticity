FROM registry.access.redhat.com/ubi9/python-312-minimal@sha256:d0ac54e77cd0be473b22fb274493526027f2746ec503b4a97ca08257813f0d4b

USER 0
RUN groupadd --gid 10001 watch-auth \
    && useradd --uid 10001 --gid watch-auth \
        --home-dir /home/watch-auth --create-home --shell /sbin/nologin watch-auth
WORKDIR /opt/watch-auth

COPY requirements-pilot.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-pilot.lock

ENV HOME=/home/watch-auth
RUN mkdir -p /home/watch-auth/.cache/watch-authenticity/detector-cache

COPY --chown=10001:10001 acquisition acquisition
COPY --chown=10001:10001 config config
COPY --chown=10001:10001 core core
COPY --chown=10001:10001 infra infra
COPY --chown=10001:10001 pilot pilot
COPY --chown=10001:10001 quality_gate quality_gate
COPY --chown=10001:10001 reference_intelligence reference_intelligence
RUN chown -R 10001:10001 /home/watch-auth/.cache \
    && python -m pip uninstall -y setuptools wheel

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "pilot.model_asset_bootstrap"]
